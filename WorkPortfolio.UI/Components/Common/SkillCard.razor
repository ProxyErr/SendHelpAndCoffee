@code {
    [Parameter]
    public string Skill { get; set; } = string.Empty;

    [Parameter]
    public int Percentage { get; set; } = 0;
}

<div class="skill-card">
    <div class="skill-header">
        <h4>@Skill</h4>
        <span class="skill-percentage">@Percentage%</span>
    </div>
    <div class="skill-bar-container">
        <div class="skill-bar" style="width: @(Percentage)%"></div>
    </div>
</div>

<style>
    .skill-card {
        background: rgba(22, 36, 42, 0.4);
        border: 1px solid #28383e;
        border-radius: 12px;
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .skill-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .skill-header h4 {
        font-size: 16px;
        font-weight: 600;
        color: #e7edf0;
        margin: 0;
        font-family: "Manrope", sans-serif;
    }

    .skill-percentage {
        font-family: "DM Mono", monospace;
        font-size: 13px;
        color: #28edf1;
        font-weight: 600;
    }

    .skill-bar-container {
        width: 100%;
        height: 8px;
        background: rgba(81, 96, 102, 0.3);
        border-radius: 4px;
        overflow: hidden;
    }

    .skill-bar {
        height: 100%;
        background: linear-gradient(90deg, #28edf1, #1dd4d7);
        border-radius: 4px;
        transition: width 0.6s ease;
    }
</style>
